# Copy this file to .env.server (ignored by Git). Requires Node 24+.
# Configure a text-chat model you have access to; no model is silently selected.
# OpenAI-compatible service (base includes /v1 when required):
JEF_BASE_URL=https://api.openai.com/v1
JEF_MODEL=
JEF_API_KEY=
# OPENAI_API_KEY is also accepted from the server environment.
# Alternative: existing local Ollama service/model (do not download implicitly).
JEF_OLLAMA_URL=http://127.0.0.1:11434
JEF_OLLAMA_MODEL=
# Optional routing preference if both transports are configured:
# JEF_PROVIDER=ollama
# Relative to apps/dashboard/ unless absolute. Private local memory + audit data:
# JEF_DATA_DIR=.local/jef
# Never use VITE_ prefixed variables for credentials.
