{
  "name": "@nthnentps/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.server.json --pretty",
    "start": "node scripts/serve.mjs preview",
    "dev:ui": "vite",
    "dev:agent": "node server/index.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "providers": "node server/ai/provider-cli.ts",
    "catalog": "node server/ai/catalog-cli.ts",
    "models": "node server/ai/verification-cli.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@react-three/fiber": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
