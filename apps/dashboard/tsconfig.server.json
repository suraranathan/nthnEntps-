{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true, "skipLibCheck": true,
