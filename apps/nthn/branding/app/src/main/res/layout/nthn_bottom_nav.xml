<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/nthn_panel"
    android:divider="@drawable/nthn_nav_divider"
    android:orientation="horizontal"
    android:showDividers="beginning">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nav_home"
        style="@style/NthnBottomNavItem"
        android:drawableTop="@drawable/ic_nthn_home"
        android:text="Home" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nav_terminal"
        style="@style/NthnBottomNavItem"
        android:drawableTop="@drawable/ic_nthn_terminal"
        android:text="Terminal" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nav_ai"
        style="@style/NthnBottomNavItem"
        android:drawableTop="@drawable/ic_nthn_ai"
        android:text="Alex" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nav_files"
        style="@style/NthnBottomNavItem"
        android:drawableTop="@drawable/ic_nthn_files"
        android:text="Files" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nav_settings"
        style="@style/NthnBottomNavItem"
        android:drawableTop="@drawable/ic_nthn_settings"
        android:text="Settings" />
</LinearLayout>
